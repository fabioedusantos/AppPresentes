<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CadastroActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <EditText android:id="@+id/txtTitulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Titulo" />
        <EditText android:id="@+id/txtValor" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Valor" android:inputType="numberDecimal" />
        <EditText android:id="@+id/txtMensagem" android:layout_width="match_parent" android:layout_height="150dp" android:gravity="top" android:hint="Mensagem" android:inputType="text|textMultiLine" />
        <Spinner android:id="@+id/spnConvidado" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/btnSalvar" android:layout_width="match_parent" android:layout_height="wrap_content" android:onClick="salvar" android:text="Salvar" />
    </LinearLayout>
</android.support.constraint.ConstraintLayout>
